{
  "name": "rn-assets-catalog",
  "version": "0.1.0",
  "description": "Zero-config image/color/app-icon asset catalog + local browser editor for React Native/Expo projects. Scans assets/images, assets/colors, and assets/app-icon and generates typed catalogs consumed via useImage()/useColor().",
  "private": true,
  "license": "UNLICENSED",
  "main": "lib/asset-catalog-core.js",
  "bin": {
    "asset-catalog-generate": "./generate-asset-catalog.js",
    "asset-catalog": "./asset-catalog-server.js"
  },
  "files": [
    "lib/",
    "generate-asset-catalog.js",
    "asset-catalog-server.js",
    "asset-catalog.html",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "react-native",
    "expo",
    "asset-catalog",
    "icons",
    "images",
    "colors",
    "app-icon",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroslavmusarliev/rn-assets-catalog.git"
  },
  "homepage": "https://github.com/miroslavmusarliev/rn-assets-catalog#readme",
  "bugs": {
    "url": "https://github.com/miroslavmusarliev/rn-assets-catalog/issues"
  },
